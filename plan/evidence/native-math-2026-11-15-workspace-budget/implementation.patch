diff --git a/src/coyote_math/math_memory_budget.ads b/src/coyote_math/math_memory_budget.ads
new file mode 100644
index 0000000..8d55ae9
--- /dev/null
+++ b/src/coyote_math/math_memory_budget.ads
@@ -0,0 +1,58 @@
+with Ada.Finalization;
+
+--  Transient reservation ledger for raster workspace.
+--
+--  Reserve charges a reservation before workspace allocation.  Release or
+--  finalization returns the charge.  Each Budget has independent accounting.
+--  The Account must outlive every Reservation that refers to it; callers
+--  are responsible for this lifetime relationship. Operations on one
+--  Reservation must not occur simultaneously. The protected ledger supports
+--  concurrent operations on independent Reservations, even on one Budget.
+--
+--  Reserve raises Budget_Exceeded when the requested charge cannot fit.
+--  Rebinding a live Reservation to another Budget raises Program_Error.
+--  The ledger serializes accounting for independent owners.
+package Math_Memory_Budget is
+   Capacity : constant Natural := 256 * 1024 * 1024;
+   subtype Byte_Limit is Natural range 0 .. Capacity;
+
+   Budget_Exceeded : exception;
+
+   type Budget (Limit : Byte_Limit := Capacity) is limited private;
+   type Budget_Access is access all Budget;
+   type Reservation is
+     new Ada.Finalization.Limited_Controlled with private;
+
+   procedure Reserve
+     (Owner   : in out Reservation;
+      Account : not null Budget_Access;
+      Bytes   : Natural);
+   procedure Release (Owner : in out Reservation);
+   function Used (Account : Budget) return Natural;
+   function Peak (Account : Budget) return Natural;
+   function Bytes (Owner : Reservation) return Natural;
+
+private
+   protected type Ledger (Limit : Byte_Limit) is
+      procedure Charge (Amount : Natural);
+      procedure Resize (Old_Amount : Natural; New_Amount : Natural);
+      procedure Uncharge (Amount : Natural);
+      function Current return Natural;
+      function Maximum return Natural;
+   private
+      Current_Bytes : Natural := 0;
+      Peak_Bytes    : Natural := 0;
+   end Ledger;
+
+   type Budget (Limit : Byte_Limit := Capacity) is limited record
+      Accounting : Ledger (Limit);
+   end record;
+
+   type Reservation is
+     new Ada.Finalization.Limited_Controlled with record
+      Account : Budget_Access := null;
+      Amount  : Natural := 0;
+   end record;
+
+   overriding procedure Finalize (Owner : in out Reservation);
+end Math_Memory_Budget;
diff --git a/src/coyote_math/math_memory_budget.adb b/src/coyote_math/math_memory_budget.adb
new file mode 100644
index 0000000..ce8bf49
--- /dev/null
+++ b/src/coyote_math/math_memory_budget.adb
@@ -0,0 +1,97 @@
+package body Math_Memory_Budget is
+   protected body Ledger is
+      procedure Charge (Amount : Natural) is
+      begin
+         if Amount > Limit - Current_Bytes then
+            raise Budget_Exceeded with
+              "math workspace memory budget exceeded";
+         end if;
+         Current_Bytes := Current_Bytes + Amount;
+         if Current_Bytes > Peak_Bytes then
+            Peak_Bytes := Current_Bytes;
+         end if;
+      end Charge;
+
+      procedure Resize (Old_Amount : Natural; New_Amount : Natural) is
+         Other_Bytes : Natural;
+      begin
+         Other_Bytes := Current_Bytes - Old_Amount;
+         if New_Amount > Limit - Other_Bytes then
+            raise Budget_Exceeded with
+              "math workspace memory budget exceeded";
+         end if;
+         Current_Bytes := Other_Bytes + New_Amount;
+         if Current_Bytes > Peak_Bytes then
+            Peak_Bytes := Current_Bytes;
+         end if;
+      end Resize;
+
+      procedure Uncharge (Amount : Natural) is
+      begin
+         Current_Bytes := Current_Bytes - Amount;
+      end Uncharge;
+
+      function Current return Natural is
+      begin
+         return Current_Bytes;
+      end Current;
+
+      function Maximum return Natural is
+      begin
+         return Peak_Bytes;
+      end Maximum;
+   end Ledger;
+
+   procedure Reserve
+     (Owner   : in out Reservation;
+      Account : not null Budget_Access;
+      Bytes   : Natural) is
+   begin
+      if Owner.Account /= null then
+         if Owner.Account /= Account then
+            raise Program_Error;
+         end if;
+         if Bytes = 0 then
+            Release (Owner);
+         else
+            Account.Accounting.Resize
+              (Old_Amount => Owner.Amount,
+               New_Amount => Bytes);
+            Owner.Amount := Bytes;
+         end if;
+      elsif Bytes /= 0 then
+         Account.Accounting.Charge (Bytes);
+         Owner.Account := Account;
+         Owner.Amount := Bytes;
+      end if;
+   end Reserve;
+
+   procedure Release (Owner : in out Reservation) is
+   begin
+      if Owner.Account /= null then
+         Owner.Account.Accounting.Uncharge (Owner.Amount);
+         Owner.Account := null;
+         Owner.Amount := 0;
+      end if;
+   end Release;
+
+   function Used (Account : Budget) return Natural is
+   begin
+      return Account.Accounting.Current;
+   end Used;
+
+   function Peak (Account : Budget) return Natural is
+   begin
+      return Account.Accounting.Maximum;
+   end Peak;
+
+   function Bytes (Owner : Reservation) return Natural is
+   begin
+      return Owner.Amount;
+   end Bytes;
+
+   overriding procedure Finalize (Owner : in out Reservation) is
+   begin
+      Release (Owner);
+   end Finalize;
+end Math_Memory_Budget;
