+              Jobs.Raster_Width (Recovery_Result.all) <= 8192 and
+              Jobs.Raster_Height (Recovery_Result.all) <= 4096 and
+              Jobs.Raster_Retained_Bytes (Recovery_Result.all) > 0 and
+              Math_Raster_Budget.Used =
