+      end Await_Math;
+
+      procedure Build_Response is
+      begin
+         Begin_Request (T.Stack.all, "mixed Markdown", Prompt);
+         Append_Text
+           (T.Stack.all, Source (Source'First .. Source'First + 7));
+         Append_Text
