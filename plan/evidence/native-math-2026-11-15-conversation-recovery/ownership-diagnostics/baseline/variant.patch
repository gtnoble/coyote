+      end Check_Display_Root;
+
+      procedure Await_Math is
+      begin
+         Deadline := Ada.Real_Time.Clock + Ada.Real_Time.Seconds (5);
+         while Ada.Real_Time.Clock < Deadline
+           and then
+             (Math_Is_Pending (T.Stack.all, 1)
