+      Buffer : Gtk.Text_Buffer.Gtk_Text_Buffer;
+      View : Gtk.Text_View.Gtk_Text_View := null;
+      Parent_Window : Gtk.Window.Gtk_Window := null;
+      Rendered : Coyote_Renderer.Markup.Render_Result;
+      Images_Remaining : Natural := 0;
