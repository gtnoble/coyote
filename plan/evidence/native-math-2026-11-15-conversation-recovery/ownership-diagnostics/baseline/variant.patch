+
+      procedure Wait_For_Raster_Baseline is
+      begin
+         Coyote_Math_Jobs.Shutdown;
+         Deadline := Ada.Real_Time.Clock + Ada.Real_Time.Seconds (5);
+         while Coyote_GUI.Math_Element.Retained_Raster_Bytes /= Baseline
