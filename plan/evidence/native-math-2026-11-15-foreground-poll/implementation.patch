+               exit when Mixed_Status /= Jobs.Pending;
+               delay 0.005;
+            end loop;
+            Check (Mixed_Status = Jobs.Valid and Mixed_Result /= null,
+              "large mixed-color worker result valid" & Iteration'Image);
+            if Mixed_Result /= null then
