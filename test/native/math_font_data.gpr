project Math_Font_Data is
   for Languages use ("Ada");
   for Source_Dirs use ("../../src/coyote_math", "../tools");
   for Source_Files use
     ("math_font_data.ads", "math_font_data.adb",
      "math_font_data_probe.adb");
   for Object_Dir use External ("MATH_FONT_DATA_ROOT") & "/obj";
   for Exec_Dir use External ("MATH_FONT_DATA_ROOT") & "/bin";
   for Create_Missing_Dirs use "True";
   for Main use ("math_font_data_probe.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-g", "-O0", "-gnata", "-gnato");
   end Compiler;
end Math_Font_Data;
