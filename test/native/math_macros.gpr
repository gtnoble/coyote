project Math_Macros is
   for Languages use ("Ada");
   for Source_Dirs use ("../../src/coyote_math", "../tools");
   for Source_Files use
     ("math_source.ads", "math_source.adb", "math_unicode.ads",
      "math_unicode.adb", "math_tokens.ads", "math_tokens.adb", "math_macros.ads", "math_macros.adb",
      "math_builtin_macros.ads", "math_builtin_macros.adb",
      "math_model.ads", "math_symbols.ads", "math_symbols.adb",
      "math_expander.ads", "math_expander.adb", "math_macros_probe.adb");
   for Object_Dir use External ("MATH_MACROS_ROOT") & "/obj";
   for Exec_Dir use External ("MATH_MACROS_ROOT") & "/bin";
   for Create_Missing_Dirs use "True";
   for Main use ("math_macros_probe.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-g", "-O0", "-gnata", "-gnato",
         "-gnatyI");
   end Compiler;
end Math_Macros;
