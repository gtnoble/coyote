project Math_Memory_Budget is
   for Languages use ("Ada");
   for Source_Dirs use ("../../src/coyote_math", "../tools");
   for Source_Files use
     ("math_memory_budget.ads", "math_memory_budget.adb",
      "math_memory_budget_probe.adb");
   for Object_Dir use
     External ("MATH_MEMORY_BUDGET_ROOT") & "/obj";
   for Exec_Dir use
     External ("MATH_MEMORY_BUDGET_ROOT") & "/bin";
   for Create_Missing_Dirs use "True";
   for Main use ("math_memory_budget_probe.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-g", "-O0", "-gnata", "-gnato");
   end Compiler;
end Math_Memory_Budget;
