project Math_Paths is
   for Languages use ("Ada");
   for Source_Dirs use ("../../src/coyote_math", "../tools");
   for Source_Files use ("math_paths.ads", "math_paths.adb",
     "math_stretchy.ads", "math_stretchy.adb",
     "math_paths_probe.adb");
   for Object_Dir use External ("MATH_PATHS_ROOT") & "/obj";
   for Exec_Dir use External ("MATH_PATHS_ROOT") & "/bin";
   for Create_Missing_Dirs use "True";
   for Main use ("math_paths_probe.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-g", "-O0", "-gnata", "-gnato");
   end Compiler;
end Math_Paths;
