project Math_Radical_Paths is
   for Languages use ("Ada");
   for Source_Dirs use ("../../src/coyote_math", "../tools");
   for Source_Files use
     ("math_paths.ads", "math_paths.adb", "math_radical_paths.ads",
      "math_radical_paths.adb", "math_radical_path_probe.adb");
   for Object_Dir use External ("MATH_RADICAL_PATHS_ROOT") & "/obj";
   for Exec_Dir use External ("MATH_RADICAL_PATHS_ROOT") & "/bin";
   for Create_Missing_Dirs use "True";
   for Main use ("math_radical_path_probe.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-g", "-O0", "-gnata", "-gnato");
   end Compiler;
end Math_Radical_Paths;
