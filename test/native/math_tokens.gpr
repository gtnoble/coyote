project Math_Tokens is
   for Languages use ("Ada");
   for Source_Dirs use ("../../src/coyote_math", "../tools");
   for Source_Files use
     ("math_source.ads", "math_source.adb", "math_unicode.ads",
      "math_unicode.adb", "math_tokens.ads", "math_tokens.adb",
      "math_tokens_probe.adb");
   for Object_Dir use External ("MATH_TOKENS_ROOT") & "/obj";
   for Exec_Dir use External ("MATH_TOKENS_ROOT") & "/bin";
   for Create_Missing_Dirs use "True";
   for Main use ("math_tokens_probe.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-g", "-O0", "-gnata", "-gnato");
   end Compiler;
end Math_Tokens;
