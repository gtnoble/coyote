with "config/coyote_test_config.gpr";
project Coyote_Test is

   for Source_Dirs use ("src/", "config/", "tools/");
   for Object_Dir use "obj/" & Coyote_Test_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("coyote_test.adb", "mock_coyote.adb");

   package Compiler is
      for Default_Switches ("Ada") use Coyote_Test_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      for Switches ("Ada") use ("-lcurl");
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Coyote_Test;
