    {
      "id": "newline-extra-margin",
      "source": "x\\\\[.5em]y",
      "displayMode": false,
      "emPixels": 24,
      "expectedLineBreak": true,
      "expectedExtraMarginEm": 0.5,
      "marginSemantics": "\u005c\u005c[ consumes the optional dimension; this is not \u005cnewline[.5em], because KaTeX expands \u005cnewline to \u005c\u005c\u005crelax before scanning the option."
    },
    {
      "id": "newline-macro-literal-brackets",
      "source": "x\\newline[.5em]y",
      "displayMode": false,
      "emPixels": 24,
      "expectedLineBreak": true,
      "expectedLiteralText": "[.5em]",
      "semanticsNote": "KaTeX \u005cnewline expands to \u005c\u005c\u005crelax; the following bracket text is ordinary input."
    }
