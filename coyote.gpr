with "gtkada";
with "config/coyote_config.gpr";
project Coyote is

   for Languages use ("Ada", "C");
   for Source_Dirs use ("src/", "src/llm/", "src/coyote_gui/",
                        "src/coyote_sqc/", "src/coyote_renderer/",
                        "config/", "tools/");
   for Object_Dir use "obj/" & Coyote_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("coyote.adb", "coyote_list_sessions.adb",
                 "coyote_open.adb", "coyote_sqc_main.adb");

   --  gprof profiling flag; passed via -XCOYOTE_PROFILE=true.
   Profile_Enabled := external ("COYOTE_PROFILE", "false");

   package Builder is
      for Executable ("coyote_sqc_main.adb") use "coyote_sqc";
   end Builder;

   package Compiler is
      case Coyote_Config.Build_Profile is
         when "development" =>
            for Default_Switches ("Ada") use Coyote_Config.Ada_Compiler_Switches;
         when others =>
            for Default_Switches ("Ada") use Coyote_Config.Ada_Compiler_Switches
              & ("-gnatVn");
      end case;
      case Profile_Enabled is
         when "true" =>
            for Switches ("C") use ("-O2", "-I/usr/include/x86_64-linux-gnu", "-pg");
         when others =>
            for Switches ("C") use ("-O2", "-I/usr/include/x86_64-linux-gnu");
      end case;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      case Profile_Enabled is
         when "true" =>
            for Switches ("Ada") use ("-lcurl", "-lutil", "-lcmark-gfm", "-lcmark-gfm-extensions", "-pg");
         when others =>
            for Switches ("Ada") use ("-lcurl", "-lutil", "-lcmark-gfm", "-lcmark-gfm-extensions");
      end case;
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Coyote;
